# Server Environment Example (DO NOT commit real secrets here)
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:password@localhost:5433/doodcafe
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5174
ADMIN_EMAIL=admin@doodcafe.com
ADMIN_PASSWORD=your_admin_password
