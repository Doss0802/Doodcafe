NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.eos8oyt.mongodb.net/Doodcafe?appName=Cluster0

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Admin seed credentials (used by seed.js)
ADMIN_EMAIL=admin@doodcafe.com
ADMIN_PASSWORD=Admin@123
