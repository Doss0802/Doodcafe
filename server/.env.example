# Server Environment Example (DO NOT commit real secrets here)
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:password@localhost:5433/doodcafe
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5174
FRONTEND_URL=https://doodcafe-frontend.onrender.com
ADMIN_EMAIL=admin@doodcafe.com
ADMIN_PASSWORD=your_admin_password

# File Uploads Directory (local disk storage; note: on Render, ephemeral disk is reset on deploys/restarts)
UPLOAD_DIR=uploads

# Public backend URL — required on Render (and any reverse-proxy host).
# Used to construct absolute image URLs returned by GET /api/offers.
# Must be the full public HTTPS URL of the backend service, no trailing slash.
# Example: https://doodcafe.onrender.com
PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Offers Banner Image Storage (db | cloudinary, defaults to db)
OFFERS_STORAGE=db

# Cloudinary Image Storage (for Offers banner images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paytm Payment Gateway (JS Checkout)
ENABLE_ONLINE_PAYMENT=false
PAYTM_MID=your_paytm_mid
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging
PAYTM_CALLBACK_URL=https://doodcafe.onrender.com/api/payment/callback
